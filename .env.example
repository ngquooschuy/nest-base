NODE_ENV=development
PORT=3000
APP_NAME=nest-base
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=
REQUEST_TIMEOUT_MS=
DB_USER=
DB_PASSWORD=
DB_NAME=nest_base
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_base?schema=public
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
JWT_ACCESS_SECRET=<secret-1>
JWT_ACCESS_TTL=900          # giây = 15 phút
JWT_REFRESH_SECRET=<secret-2>
JWT_REFRESH_TTL=604800      # giây = 7 ngày, dùng ở Bài 13
FRONTEND_URL=http://localhost:4200
TRUST_PROXY=0
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nest Base <no-reply@nest-base.local>"